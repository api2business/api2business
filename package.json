{
  "name": "api2business",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cli": "bun skills/api2business/scripts/api2business-cli.ts --config config/api2business.yaml",
    "api": "bun --hot src/api.ts --config config/api2business.yaml --runtime native",
    "worker": "go-worker/bin/api2business-temporal-worker --config config/api2business.yaml --runtime native",
    "dev:web": "API2BUSINESS_CONFIG_PATH=config/api2business.yaml API2BUSINESS_RUNTIME_ID=native bunx vite --config vite.config.ts",
    "check": "bunx tsc --noEmit",
    "deploy:validate": "bun scripts/deploy/validate.mjs"
  },
  "dependencies": {
    "@temporalio/client": "^1.20.3",
    "@temporalio/worker": "^1.20.3",
    "@temporalio/workflow": "^1.20.3",
    "fflate": "^0.8.3",
    "luxon": "^3.7.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/luxon": "^3.7.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  },
  "trustedDependencies": [
    "@swc/core",
    "protobufjs"
  ]
}
